# cp .env.example .env  — 설명: docs/02-containers.md
# (주의: 값 뒤에 주석을 달지 마세요. 줄 단위 주석만 사용)

# ── C1 Gateway ──
# 비우면 cloudflared /quicktunnel 자동 조회
PUBLIC_URL=
MAX_INFLIGHT=4
# 0 = precise(SAM 2) 끔
PRECISE_INTERVAL_MS=700
STAGE_TIMEOUT_MS=3000

# ── C2 Preprocess ──
TARGET_WIDTH=640

# ── C3 Inference ──
C3_REPLICAS=2
# mock | fast | precise
C3_BACKEND=fast
# 1 = 이미지에 torch-cpu + sam2 설치 (빌드 시)
WITH_SAM2=0
# 1 = 기동 시 SAM 2 로드
SAM2_ENABLED=0
SAM2_CKPT=/models/sam2.1_hiera_tiny.pt
SAM2_CFG=configs/sam2.1/sam2.1_hiera_t.yaml
CIRC_TH=0.80
SOLID_TH=0.95
MIN_AREA_RATIO=0.002
# 코어 수 / C3_REPLICAS
OMP_NUM_THREADS=2

# ── C4 Visualizer ──
LINE_X=0.5
DIRECTION=rtl
MAX_MISSES=5
MATCH_MAX_DIST=0.6
JPEG_QUALITY=70

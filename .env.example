# cp .env.example .env  — 설명: docs/02-containers.md
# (주의: 값 뒤에 주석을 달지 마세요. 줄 단위 주석만 사용)

# ── C1 Gateway ──
# 비우면 cloudflared /quicktunnel 자동 조회
PUBLIC_URL=
MAX_INFLIGHT=4
# uncertain(애매한 과자가 있을 때만 SAM 2) | interval(주기적) | off
PRECISE_POLICY=uncertain
# precise 요청 사이 최소 간격
PRECISE_INTERVAL_MS=300
STAGE_TIMEOUT_MS=3000

# ── C2 Preprocess ──
# 3개 라인을 한 화면에 담으면 과자가 작아지므로 960 권장
TARGET_WIDTH=960

# ── C3 Inference ──
C3_REPLICAS=2
# mock | fast | precise
C3_BACKEND=fast
# 1 = 이미지에 torch-cpu + sam2 설치 (빌드 시)
WITH_SAM2=0
# 1 = 기동 시 SAM 2 로드
SAM2_ENABLED=0
SAM2_CKPT=/models/sam2.1_hiera_tiny.pt
SAM2_CFG=configs/sam2.1/sam2.1_hiera_t.yaml
CIRC_TH=0.935
SOLID_TH=0.95
MIN_AREA_RATIO=0.0005
# 코어 수 / C3_REPLICAS
OMP_NUM_THREADS=2

# ── C4 Visualizer ──
# 시뮬레이터 검사선(화면 폭 34%)과 일치 — ROI로 캔버스만 잘랐을 때 기준
LINE_X=0.34
DIRECTION=rtl
MAX_MISSES=5
MATCH_MAX_DIST=0.6
JPEG_QUALITY=70

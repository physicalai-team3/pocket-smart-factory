# cp .env.example .env  — 설명: docs/02-containers.md
# (주의: 값 뒤에 주석을 달지 마세요. 줄 단위 주석만 사용)

# ── C1 Gateway ──
# 비우면 cloudflared /quicktunnel 자동 조회
PUBLIC_URL=
MAX_INFLIGHT=4
# uncertain(애매한 과자가 있을 때만 SAM 2) | interval(주기적) | off
PRECISE_POLICY=uncertain
# precise 요청 사이 최소 간격
PRECISE_INTERVAL_MS=300
STAGE_TIMEOUT_MS=3000
# precise(SAM 2) 의 C3 호출만 따로 — CPU SAM 2 는 2~5초 걸릴 수 있다
PRECISE_TIMEOUT_MS=10000
# 폰 기본 전송 fps. 드롭이 30%를 넘으면 C1이 throttle 로 낮추고, 드롭이 없으면 1씩 되돌린다
TARGET_FPS=10
# 폰·대시보드가 모두 끊긴 세션을 지우기까지 (초)
SESSION_TTL_S=600

# ── C2 Preprocess ──
# 3개 라인을 한 화면에 담으면 과자가 작아지므로 960 권장
TARGET_WIDTH=960
# 0 = CLAHE 끔. 조명 불균일 대응이 필요하면 2.0 (OpenCV 기본값 40은 너무 강함)
CLAHE_CLIP=0
# OpenCV 스레드 수
CV_THREADS=2

# ── C3 Inference ──
C3_REPLICAS=2
# mock | fast | precise
C3_BACKEND=fast
# 1 = 이미지에 torch-cpu + sam2 설치 (빌드 시)
WITH_SAM2=0
# 1 = 기동 시 SAM 2 로드
SAM2_ENABLED=0
SAM2_CKPT=/models/sam2.1_hiera_tiny.pt
SAM2_CFG=configs/sam2.1/sam2.1_hiera_t.yaml
CIRC_TH=0.935
SOLID_TH=0.95
MIN_AREA_RATIO=0.0005
# 코어 수 / C3_REPLICAS
OMP_NUM_THREADS=2

# ── C4 Visualizer ──
# 시뮬레이터 검사선(화면 폭 34%)과 일치 — ROI로 캔버스만 잘랐을 때 기준
LINE_X=0.34
DIRECTION=rtl
MAX_MISSES=5
MATCH_MAX_DIST=0.6
JPEG_QUALITY=70
